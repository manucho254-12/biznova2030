# Copy this file to ".env" (same folder as app.py) and fill in real values.
# ".env" itself is gitignored — never commit your real secrets.

# Flask
SECRET_KEY=change-this-to-a-long-random-string
FLASK_DEBUG=0

# Database (MySQL). Leave unset to use the default below — update the
# username/password/host to match your MySQL server. The "biznova"
# database must already exist (CREATE DATABASE biznova;).
DATABASE_URL=mysql+pymysql://root:@localhost:3306/biznova?charset=utf8mb4

# PayHero (https://app.payhero.co.ke) — the payment provider used for activation fees
# and STK Push. API Username/Password come from your PayHero account's API/Developer
# settings — NOT your portal login. Channel ID is under Payment Channels -> My Payment
# Channels.
PAYHERO_API_USERNAME=YOUR_API_USERNAME
PAYHERO_API_PASSWORD=YOUR_API_PASSWORD
PAYHERO_CHANNEL_ID=YOUR_CHANNEL_ID
PAYHERO_PROVIDER=m-pesa
PAYHERO_CALLBACK_URL=https://yourdomain.com/payhero/callback/YOUR_CALLBACK_SECRET_HERE

# The secret embedded in the callback URL above, so only genuine PayHero callbacks are
# accepted. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(24))"
PAYHERO_CALLBACK_SECRET=generate-a-long-random-string-and-put-it-in-the-callback-url-above-too

# Email (Brevo SMTP relay, or any SMTP provider)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login-email
SMTP_PASSWORD=your-brevo-smtp-key
SMTP_FROM=your-verified-sender-email
SMTP_FROM_NAME=BizNova
